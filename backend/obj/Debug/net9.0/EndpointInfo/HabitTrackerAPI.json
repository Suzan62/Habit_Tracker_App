          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "additionalProperties": false
      },
      "CreateHabitDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "targetCount": {
            "type": "integer",
            "format": "int32"
          },
          "unit": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "reminderTime": {
            "type": "string",
            "nullable": true
          },
          "daysOfWeek": {
            "type": "string",
            "nullable": true
          },
          "pointsReward": {
            "type": "integer",
            "format": "int32"
          },
          "isPublic": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ForgotPasswordRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          }
        },
        "additionalProperties": false
      },
      "FriendRequestDto": {
        "type": "object",
        "properties": {
          "addresseeId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "GoogleLoginRequest": {
        "required": [
          "idToken"
        ],
        "type": "object",
        "properties": {
          "idToken": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Habit": {
        "required": [
          "name",
          "userId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "$ref": "#/components/schemas/HabitType"
          },
          "category": {
            "$ref": "#/components/schemas/HabitCategory"
          },
          "targetCount": {
            "type": "integer",
            "format": "int32"
          },
          "unit": {
            "type": "string",
            "nullable": true
          },
          "reminderTime": {
            "type": "string",
            "format": "time",
            "nullable": true
          },
          "daysOfWeek": {
            "type": "string",
            "nullable": true
          },
          "pointsReward": {
            "type": "integer",
            "format": "int32"
          },
          "isActive": {
            "type": "boolean"
          },
          "isPublic": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "currentStreak": {
            "type": "integer",
            "format": "int32"
          },
          "bestStreak": {
            "type": "integer",
            "format": "int32"
          },
          "completionCount": {
            "type": "integer",
            "format": "int32"
          },
          "habitLogs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HabitLog"
            },
            "nullable": true
          },
          "reminders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HabitReminder"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "HabitCategory": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "type": "integer",
        "format": "int32"
      },
      "HabitLog": {
        "required": [
          "habitId",
          "userId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "habitId": {
            "type": "integer",
            "format": "int32"
          },
          "logDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/HabitLogStatus"
          },
          "completedCount": {
            "type": "integer",
            "format": "int32"
          },
          "targetCount": {
            "type": "integer",
            "format": "int32"
          },
          "notes": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "pointsEarned": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "habit": {
            "$ref": "#/components/schemas/Habit"
          }
        },
        "additionalProperties": false
      },
      "HabitLogDto": {
        "type": "object",
        "properties": {
          "logDate": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/HabitLogStatus"
          },
          "completedCount": {
            "type": "integer",
            "format": "int32"
          },
          "targetCount": {
            "type": "integer",
            "format": "int32"
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "pointsEarned": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "HabitLogStatus": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "HabitReminder": {
        "required": [
          "habitId",
          "reminderTime"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "habitId": {
            "type": "integer",
            "format": "int32"
          },
          "reminderTime": {
            "type": "string",
            "format": "time"
          },
          "type": {
            "$ref": "#/components/schemas/ReminderType"
          },
          "customSchedule": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "lastSent": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "nextScheduled": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "habit": {
            "$ref": "#/components/schemas/Habit"
